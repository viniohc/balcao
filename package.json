{
  "name": "festa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:firestore": "firebase emulators:exec --project demo-festa-camarao --only firestore \"node --test scripts/test-firestore.mjs && vitest run --config vitest.emulator.config.ts\"",
    "dev:demo": "vite --config vite.demo.config.ts",
    "build:demo": "vue-tsc -b && vite build --config vite.demo.config.ts"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "fake-indexeddb": "^6.2.6",
    "firebase-tools": "^15.34.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.9"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.8.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "dexie": "^4.4.2",
    "firebase": "^12.13.0",
    "jsdom": "^29.1.1",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  }
}
